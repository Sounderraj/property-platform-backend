{
  "info": {
    "name": "Property Platform API",
    "description": "Import this collection, then set **webhookSecret** (Collection → Variables) to the exact **CRM_WEBHOOK_SECRET** from Render Dashboard → property-platform-api → Environment. It must match character-for-character — not your local .env unless you set Render to the same value.\n\nOrder: 1) Create Enquiry  2) CRM Webhook (signature is auto-generated).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://property-platform-api.onrender.com" },
    { "key": "enquiryId", "value": "" },
    { "key": "webhookSecret", "value": "PASTE_YOUR_RENDER_CRM_WEBHOOK_SECRET_HERE" },
    { "key": "webhookSignature", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create Enquiry",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('enquiryId', json.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Smith\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+441234567890\",\n  \"message\": \"I would like to arrange a viewing for this property.\",\n  \"propertyRef\": \"PROP-001\",\n  \"source\": \"web\"\n}"
        },
        "url": "{{baseUrl}}/api/enquiry"
      }
    },
    {
      "name": "Get Enquiry",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/enquiry/{{enquiryId}}"
      }
    },
    {
      "name": "List Enquiries",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/enquiries?page=1&limit=20"
      }
    },
    {
      "name": "CRM Webhook",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const secret = (pm.collectionVariables.get('webhookSecret') || '').trim();",
              "const body = pm.variables.replaceIn(pm.request.body.raw);",
              "if (!secret || secret.includes('PASTE_YOUR')) {",
              "  throw new Error('Set webhookSecret to your Render CRM_WEBHOOK_SECRET');",
              "}",
              "if (!body || body.includes('{{')) {",
              "  throw new Error('Run Create Enquiry first so enquiryId is set');",
              "}",
              "const signature = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({ key: 'X-Webhook-Signature', value: signature });",
              "console.log('Body signed:', body);",
              "console.log('X-Webhook-Signature:', signature);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"event\":\"enquiry.synced\",\"enquiryId\":\"{{enquiryId}}\",\"externalId\":\"CRM-12345\"}"
        },
        "url": "{{baseUrl}}/api/webhook/crm"
      }
    },
    {
      "name": "List Properties",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/properties"
      }
    },
    {
      "name": "Get Property by Slug",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/properties/luxury-apartment-london"
      }
    },
    {
      "name": "Invalidate Cache",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"secret\": \"change-me-cache-secret\"\n}"
        },
        "url": "{{baseUrl}}/api/admin/cache/invalidate"
      }
    }
  ]
}
