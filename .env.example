NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Set true when using Docker Redis locally; false for Render (no Upstash)
USE_REDIS=true

DATABASE_URL=postgresql://property_user:property_pass@localhost:5432/property_db?schema=public

REDIS_URL=redis://localhost:6379

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_ENQUIRY_MAX=10

# CRM webhook HMAC secret (min 32 chars in production)
CRM_WEBHOOK_SECRET=change-me-to-a-long-random-secret-in-production

# WordPress WPGraphQL
WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql
WORDPRESS_CACHE_TTL_SECONDS=300

# Idempotency key TTL (seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# Logging
LOG_LEVEL=info

# Admin cache invalidation (set in production)
CACHE_INVALIDATION_SECRET=change-me-cache-secret
